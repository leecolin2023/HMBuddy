# 通用忽略规则（按需增删）

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*.swo

# 日志与临时文件
*.log
logs/
tmp/
temp/

# 环境变量 / 密钥（切勿提交）
.env
.env.*
*.pem
*.key

# 依赖与构建产物
node_modules/
dist/
build/
out/
__pycache__/
*.pyc
.venv/
venv/
target/
*.class
bin/
obj/

# 测试与覆盖率
coverage/
.nyc_output/
.pytest_cache/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
