{
  "id": "hmbuddy.xls.core",
  "name": "Legacy XLS Plugin",
  "version": "0.1.0",
  "api_version": 1,
  "description": "遗留 .xls 读取（xlrd → Excel/WPS COM 回退，懒加载）",
  "entrypoint": {
    "module": "plugins.xls.plugin",
    "class": "XlsPlugin"
  },
  "accepts": {
    "extensions": [
      ".xls"
    ]
  },
  "capabilities": [
    {
      "id": "artifact.read.full",
      "priority": 100
    }
  ],
  "permissions": [
    "filesystem.read",
    "office.com",
    "wps.com"
  ],
  "platforms": [
    "windows",
    "linux",
    "darwin"
  ],
  "runtime": {
    "python": ">=3.10"
  }
}
